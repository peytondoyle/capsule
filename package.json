{
  "name": "capsule",
  "version": "2.0.0",
  "private": true,
  "description": "A personal archive of the objects people gave you.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:sw && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:seed": "NODE_OPTIONS='--conditions=react-server' dotenv -e .env.local -- tsx scripts/seed.ts",
    "db:check": "dotenv -e .env.local -- drizzle-kit check",
    "db:verify": "NODE_OPTIONS='--conditions=react-server' dotenv -e .env.local -- tsx scripts/verify-p2.ts",
    "db:verify:p6": "NODE_OPTIONS='--conditions=react-server' dotenv -e .env.local -- tsx scripts/verify-p6.ts",
    "build:sw": "esbuild src/sw.ts --bundle --minify --format=esm --outfile=public/sw.js",
    "db:verify:upload": "NODE_OPTIONS='--conditions=react-server' dotenv -e .env.local -- tsx scripts/verify-upload.ts",
    "dev:verify": "node -e \"const u=process.env.DATABASE_URL_VERIFY;if(!u)throw new Error('DATABASE_URL_VERIFY not set');process.env.DATABASE_URL=u;process.env.DATABASE_URL_UNPOOLED=process.env.DATABASE_URL_UNPOOLED_VERIFY||u;const b=process.env.BLOB_READ_WRITE_TOKEN_VERIFY,o=process.env.BLOB_ORIGINALS_READ_WRITE_TOKEN_VERIFY;if(b)process.env.BLOB_READ_WRITE_TOKEN=b;if(o)process.env.BLOB_ORIGINALS_READ_WRITE_TOKEN=o;if(!b||!o)console.warn('\\\\n*** dev:verify: rows are branched but BLOBS ARE NOT \u2014 no *_VERIFY blob tokens set, so uploads and derives write into the PRODUCTION stores (as new, never-overwriting blobs). Create scratch stores and set BLOB_READ_WRITE_TOKEN_VERIFY / BLOB_ORIGINALS_READ_WRITE_TOKEN_VERIFY to isolate bytes too. ***\\\\n');require('child_process').spawn('npm',['run','dev'],{stdio:'inherit',env:process.env})\"",
    "db:verify:desktop": "NODE_OPTIONS='--conditions=react-server' dotenv -e .env.local -- tsx scripts/verify-desktop.ts",
    "db:verify:warp": "NODE_OPTIONS='--conditions=react-server' dotenv -e .env.local -- tsx scripts/verify-warp.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@clerk/nextjs": "^7.6.1",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.6.1",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "next": "16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serwist": "^9.5.12",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "next": {
      "sharp": "^0.35.3"
    }
  }
}
