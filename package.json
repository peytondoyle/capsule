{
  "name": "capsule",
  "version": "2.0.0",
  "private": true,
  "description": "A personal archive of the objects people gave you.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:seed": "NODE_OPTIONS='--conditions=react-server' dotenv -e .env.local -- tsx scripts/seed.ts",
    "db:check": "dotenv -e .env.local -- drizzle-kit check",
    "db:verify": "NODE_OPTIONS='--conditions=react-server' dotenv -e .env.local -- tsx scripts/verify-p2.ts"
  },
  "overrides": {
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.1",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.6.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3"
  }
}
