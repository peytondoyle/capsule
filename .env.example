# Copy to .env.local. Most of these are provisioned by the platform:
#   vercel env pull .env.local      -> Neon + Blob + anything set on the project
#   clerk env pull                  -> Clerk publishable + secret key
# Values are never committed.

# --- Neon Postgres (Vercel Marketplace: `vercel integration add neon`) ---
# Pooled connection. Used by drizzle-orm/neon-http for ordinary queries.
DATABASE_URL=
# Direct connection. Needed for transactions (lot-number allocation) and drizzle-kit.
DATABASE_URL_UNPOOLED=

# --- Vercel Blob (`vercel blob create-store capsule-media --access public`) ---
# Public store: cutouts, masks, thumbnails. The hot, CDN-cached path.
BLOB_READ_WRITE_TOKEN=
# Private store for untouched originals is added in phase 6; see docs/CAPSULE-V2-PLAN.md.

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
# Optional. From the Clerk dashboard when the webhook endpoint is registered.
# Without it /api/webhooks/clerk fails closed with 400, which is safe: the users
# row is created synchronously by ensureUser(), so the webhook only propagates
# later user.updated / user.deleted events.
CLERK_WEBHOOK_SIGNING_SECRET=
